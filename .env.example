# ===== Turso (قاعدة البيانات) - مجاني =====
# قيمة واحدة لكل متغيّر بلا تنصيص ولا `KEY=` ولا سطر ثانٍ. الرابط من Turso ← القاعدة ← Connect
# (`libsql://<db>-<org>.turso.io`)، والرمز JWT يبدأ بـ`eyJ` — لا رابط لوحة التحكم (app.turso.tech).
# الأخطاء الشائعة في اللصق يُصلحها الكود آليًا ويكتب السبب في السجل (`db_config_*`)، لكن صحّح القيمة:
# انظر DEPLOYMENT.md ← «قيم Turso في Vercel».
TURSO_DATABASE_URL=libsql://your-db-name-username.turso.io
TURSO_AUTH_TOKEN=your_turso_token

# ===== الشات بوت سيليا - اختر واحد أو الاثنين (مجاني) =====
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# علم الميزة للمحرك النمطي الموحّد (المرحلة الأولى). معطّل افتراضيًا:
# غيابه أو أي قيمة غير `true` يُبقي السلوك القديم المستقر كما هو حرفيًا.
ENABLE_AI_AGENT=false

# ===== NVIDIA NIM (اختياري — المرحلة الثانية) =====
# غياب المفتاح يعني أن المزود غير متاح ويُتخطى صامتًا، فلا يتغير أي سلوك قديم.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
# رابط NIM مخصّص (سحابي أو مستضاف داخليًا) — يجب أن يبدأ بـ https:// وإلا فالمزود غير متاح.
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ===== طبقة MCP المحكومة (المرحلة الثانية) — معطّلة افتراضيًا =====
ENABLE_MCP_TOOLS=false
# قائمة أسماء مفصولة بفواصل؛ غيابها = المجموعة الافتراضية للقراءة فقط.
# MCP_ALLOWED_TOOLS=search_products,lookup_faq,shipping_estimate,store_info
# بوابة مستقلة للأدوات الكاتبة — مغلقة حتى لو كانت الطبقة مفعّلة.
# MCP_ALLOW_WRITE_TOOLS=false
# حدود مركزية مقيّدة: سقف الاستدعاءات 0..8، المهلة 300..10000 مللي، المخرجات 200..20000 حرفًا.
# MCP_MAX_CALLS_PER_REQUEST=3
# MCP_TOOL_TIMEOUT_MS=4000
# MCP_MAX_RESULT_CHARS=4000

# ===== أسطول وكلاء المتجر — المرحلة الرابعة (اختياري) — معطّل افتراضيًا =====
# 50 وكيلًا متخصصًا يخدمون المتجر، يختار بينهم موجّه حتمي (بلا موديل وبلا شبكة)،
# وكل وكيل يرى مجموعة فرعية من أدوات MCP للقراءة فقط. لا يعمل إلا مع ENABLE_AI_AGENT=true،
# وأي قيمة غير `true` تُبقيه مغلقًا وتُعيد السلوك السابق حرفيًا.
ENABLE_AGENT_FLEET=false
# تعطيل وكلاء بعينهم بلا تغيير كود (قائمة معرّفات مفصولة بفواصل).
# القيمة `*` (أو `all`) تعطّل كل المتخصصين وتُبقي الوكيل الافتراضي وحده — وضع طوارئ ألطف
# من إغلاق الأسطول كليًا. الوكيل الافتراضي لا يُعطَّل أبدًا. التغيير يستلزم إعادة نشر
# على Vercel (الحالة تُقرأ من البيئة لا من ذاكرة العملية — كي تتسق بين كل النسخ).
# FLEET_DISABLED_AGENTS=* 

# ===== Celia Agent — علم ميزة منفصل (المرحلة التالية) — معطّل افتراضيًا =====
# لا يغيّر أي سلوك قائم ما دام مغلقًا. عند التفعيل يقرأ نطاقاته من
# CELIA_ALLOWED_SCOPES (fail-closed: بلا نطاقات = بلا تنفيذ).
# مثال: CELIA_ALLOWED_SCOPES=products:read,orders:read,faq:read
# للتجارب المحلية فقط: CELIA_ALLOWED_SCOPES=* (لا تُستخدم في الإنتاج).
ENABLE_CELIA_AGENT=false
# CELIA_ALLOWED_SCOPES=products:read,orders:read,faq:read
# CELIA_ALLOWED_SCOPES=*
# توكن الوكيل للطلبات الخارجية (Bearer) — لا يقل عن 32 حرفًا، لا يُدفع لـ Git.
# يُستخدم فقط عندما لا تكون جلسة الإدارة صالحة.
# CELIA_AGENT_TOKEN=replace-with-32-plus-random-characters
#
# توكنات وكلاء مُدارة (CeliaTokenManager) — علم منفصل ومغلق افتراضيًا.
# عند التفعيل: كل توكن يُنشأ من تبويب «توكنات سيليا» في /admin، ويُخزَّن
# كبصمة SHA-256 فقط، ويحمل نطاقاته الخاصة (وتوكن البيئة أعلاه يبقى يعمل).
# النطاق الفعلي وقت الطلب = نطاقات التوكن متقاطعة مع CELIA_ALLOWED_SCOPES.
# التفاصيل: docs/ai/celia-token-manager.md
ENABLE_CELIA_TOKENS=false

# ===== ترتيب سلسلة التراجع (اختياري) =====
# قائمة أسماء المزودين مفصولة بفواصل؛ الأسماء غير المعروفة تُتجاهل و`local` مثبّت
# دائمًا في النهاية. غيابه يُبقي الترتيب التاريخي: gemini,groq,nvidia-nim,local.
# AI_PROVIDER_ORDER=groq,gemini,nvidia-nim

# ===== تتبع الطلبات للعملاء (اختياري) — مغلق افتراضيًا =====
# لا تفتحه إلا بعد فحوص الصفين 13 و14 في DEPLOYMENT.md. يعمل برقم الطلب +
# آخر 4 أرقام من الهاتف معًا، والرسالة موحّدة لا تكشف وجود الطلب من عدمه.
ENABLE_ORDER_TRACKING=false

# ===== لوحة التحكم =====
# كلمة مرور الإدارة — سياسة موحدة: 12 حرفًا على الأقل.
ADMIN_PASSWORD=replace-with-a-long-random-password-at-least-12-chars
# سر توقيع جلسات الإدارة فقط — لا يُستخدم لأي غرض آخر (32 حرفًا عشوائيًا على الأقل).
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# ===== لوحة الصلاحيات RBAC (اختياري) — مغلقة افتراضيًا =====
# false/غياب => السلوك القديم حرفيًا: كلمة مرور الإدارة المشتركة وجلسة واحدة
# بكل الصلاحيات. true => مستخدمون وأدوار وصلاحيات وسجل تدقيق (هجرة 0003).
# أول دخول بعد التفعيل: اسم المستخدم owner + كلمة مرور الإدارة المشتركة (مرة
# واحدة فقط) لإنشاء المالك، ثم تُدار كلمات المرور من اللوحة لا من البيئة.
# التفاصيل والتراجع: docs/security/04-rbac.md
ENABLE_RBAC=false

# ===== التشخيص (اختياري) =====
# معطل في الإنتاج افتراضيًا. عند التفعيل يجب أن يكون DIAGNOSTICS_KEY مستقلًا
# تمامًا عن ADMIN_SESSION_SECRET ولا يساويه أبدًا.
DIAGNOSTICS_ENABLED=false
DIAGNOSTICS_KEY=replace-with-an-independent-diagnostics-key-24+
