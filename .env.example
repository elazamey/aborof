# ===== Turso (قاعدة البيانات) - مجاني =====
TURSO_DATABASE_URL=libsql://your-db-name-username.turso.io
TURSO_AUTH_TOKEN=your_turso_token

# ===== الشات بوت سيليا - اختر واحد أو الاثنين (مجاني) =====
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ===== لوحة التحكم =====
# كلمة مرور الإدارة — سياسة موحدة: 12 حرفًا على الأقل.
ADMIN_PASSWORD=replace-with-a-long-random-password-at-least-12-chars
# سر توقيع جلسات الإدارة فقط — لا يُستخدم لأي غرض آخر (32 حرفًا عشوائيًا على الأقل).
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# ===== التشخيص (اختياري) =====
# معطل في الإنتاج افتراضيًا. عند التفعيل يجب أن يكون DIAGNOSTICS_KEY مستقلًا
# تمامًا عن ADMIN_SESSION_SECRET ولا يساويه أبدًا.
DIAGNOSTICS_ENABLED=false
DIAGNOSTICS_KEY=replace-with-an-independent-diagnostics-key-24+
