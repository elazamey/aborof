{
  "name": "store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "routes:inventory": "node scripts/route-inventory.mjs --check",
    "front:check": "node scripts/check-front-mandatory.mjs",
    "verify:secrets": "node scripts/verify-deploy-secrets.mjs",
    "vercel:preflight": "node scripts/vercel-preflight.mjs",
    "link:vercel": "node scripts/apply-vercel-link.mjs",
    "verify:turso": "node scripts/verify-turso.mjs",
    "migrations:plan": "node scripts/apply-migrations.mjs",
    "migrations:apply": "node --import tsx scripts/apply-migrations.mjs --apply",
    "mint:turso": "bash scripts/mint-turso-token.sh",
    "mint:turso:dry": "bash scripts/mint-turso-token.sh --dry-run",
    "audit:token": "node scripts/audit-token-lifecycle.mjs",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "security:gates": "node scripts/security-gates.mjs",
    "security:bundle": "node scripts/scan-bundle-secrets.mjs --check-env",
    "agents:export": "node --import tsx scripts/export-agent-manifests.mjs",
    "agents:check": "node --import tsx scripts/export-agent-manifests.mjs --check",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.7",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "unrs-resolver": true
  }
}
